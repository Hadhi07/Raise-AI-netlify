/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800

# Private pages: keep out of search results
/course/*
  X-Robots-Tag: noindex, nofollow
/replay/*
  X-Robots-Tag: noindex, nofollow
/payment/*
  X-Robots-Tag: noindex, nofollow
/webinar/payment/*
  X-Robots-Tag: noindex, nofollow
/thankyou/*
  X-Robots-Tag: noindex, nofollow
